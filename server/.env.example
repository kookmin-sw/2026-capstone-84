# ============================================================
# 독서토론 플랫폼 환경 변수 설정
# ============================================================
# 이 파일은 로컬 개발 환경과 AWS 프로덕션 환경 모두를 위한
# 환경 변수 템플릿입니다.
#
# 사용법:
#   cp .env.example .env
#   필요한 값을 채워 넣으세요.
# ============================================================

# === 공통 설정 ===
NODE_ENV=production
PORT=3000

# === 데이터베이스 (MySQL / Aurora) ===
# 로컬 개발 환경: DATABASE_URL 하나만 사용
# AWS 프로덕션 환경: Writer/Reader 엔드포인트를 분리하여 읽기 성능 향상
#
# [로컬 개발] 단일 MySQL 연결
DATABASE_URL="mysql://bookuser:your_password@localhost:3306/book_discussion"
#
# [AWS 프로덕션] Aurora MySQL Writer/Reader 분리
# DATABASE_WRITER_URL=mysql://user:pass@cluster-writer.cluster-xxx.ap-northeast-2.rds.amazonaws.com:3306/bookclub
# DATABASE_READER_URL=mysql://user:pass@cluster-reader.cluster-xxx.ap-northeast-2.rds.amazonaws.com:3306/bookclub
# 참고: AWS 환경에서는 DATABASE_URL=${DATABASE_WRITER_URL} 로 설정 (Prisma 마이그레이션용)

# === JWT ===
JWT_SECRET=your_jwt_secret_here
JWT_REFRESH_SECRET=your_jwt_refresh_secret_here

# === 책 검색 API (카카오) ===
KAKAO_API_KEY=your_kakao_api_key

# === AI 기능 (Google Gemini) ===
GEMINI_API_KEY=your-gemini-api-key
GEMINI_MODEL=gemini-2.5-flash

# === ElastiCache Redis ===
# 로컬 개발 환경: 미설정 시 Redis 비활성화 (인메모리 폴백)
# AWS 프로덕션 환경: ElastiCache 엔드포인트 설정
#
# [로컬 개발] 로컬 Redis 사용 시
# REDIS_HOST=localhost
# REDIS_PORT=6379
# REDIS_TLS=false
#
# [AWS 프로덕션] ElastiCache Redis
# REDIS_HOST=bookclub-redis.xxx.apne2.cache.amazonaws.com
# REDIS_PORT=6379
# REDIS_TLS=true

# === OpenSearch ===
# 로컬 개발 환경: 미설정 시 검색 기능 비활성화 (기존 DB 쿼리 폴백)
# AWS 프로덕션 환경: OpenSearch Service 엔드포인트 설정
#
# [AWS 프로덕션] OpenSearch Service
# OPENSEARCH_ENDPOINT=https://bookclub-search.ap-northeast-2.es.amazonaws.com
# OPENSEARCH_REGION=ap-northeast-2

# === S3 스토리지 ===
# 로컬 개발 환경: 미설정 시 로컬 파일시스템 사용 (기존 multer 동작 유지)
# AWS 프로덕션 환경: S3 버킷에 파일 업로드
#
# [AWS 프로덕션] S3 버킷 설정
# S3_BUCKET_UPLOADS=bookclub-uploads
# S3_BUCKET_ASSETS=bookclub-assets
# S3_REGION=ap-northeast-2

# === CloudFront CDN ===
# 로컬 개발 환경: 미설정 시 로컬 경로로 이미지 제공
# AWS 프로덕션 환경: CloudFront를 통한 정적 파일/이미지 제공
#
# [AWS 프로덕션] CloudFront 도메인
# CLOUDFRONT_DOMAIN=cdn.bookclub.example.com
