{
  "name": "chat-rooms",
  "version": "1.0.0",
  "private": true,
  "description": "Real-time chat room application",
  "scripts": {
    "build:client": "cd client && npm run build",
    "build:server": "cd server && npx tsc",
    "build": "npm run build:client && npm run build:server",
    "start": "node server/dist/index.js",
    "dev:server": "cd server && npx ts-node src/index.ts",
    "test": "jest --run",
    "test:watch": "jest"
  },
  "dependencies": {
    "better-sqlite3": "^11.7.0",
    "cors": "^2.8.5",
    "express": "^4.21.0",
    "socket.io": "^4.8.0",
    "uuid": "^10.0.0"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^7.6.12",
    "@types/cors": "^2.8.17",
    "@types/express": "^5.0.0",
    "@types/jest": "^29.5.14",
    "@types/node": "^22.10.0",
    "@types/supertest": "^7.2.0",
    "@types/uuid": "^10.0.0",
    "fast-check": "^3.23.0",
    "jest": "^29.7.0",
    "supertest": "^7.2.2",
    "ts-jest": "^29.2.0",
    "ts-node": "^10.9.2",
    "typescript": "^5.7.0"
  }
}
